// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client-main"
}

datasource db {
  // provider = "mysql"
  provider = "postgresql"
  url      = env("DATABASE_URL_MAIN")
}

enum statusIssue {
  new
  progress
  solved
}

enum RecordStatus {
  INACTIVE @map("0")
  ACTIVE   @map("1")
  DELETE   @map("2")
}

model OccCategory {
  id        Int       @id @default(autoincrement()) @db.Integer
  category  String
  createdBy String
  modifyBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  occCategory OccDescription[]
}

model OccDescription {
  id          Int       @id @default(autoincrement()) @db.Integer
  id_category Int
  object      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String
  modifyBy    String?

  category OccCategory @relation(fields: [id_category], references: [id])
}

model OccIssue {
  id           Int         @id @default(autoincrement()) @db.Integer
  ticket       String
  category     String?
  lokasi       String?
  description  String?
  gate         String?
  action       String?
  foto_in      String?
  foto_out     String?
  number_plate String?
  TrxNo        String?
  solusi       String?
  duration     String?
  status       statusIssue @default(new)
  createdBy    String
  modifiedBy   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
}

model OccRefLocation {
  id                Int          @id @default(autoincrement()) @db.Integer
  Code              String       @unique
  Name              String
  Region            String?
  TID               String?
  Vendor            String?
  VendorParkingCode String?
  ShortName         String?
  Address           String?
  StartTime         DateTime?
  EndTime           DateTime?
  DateNext          Int?
  TimeZone          String?
  UrlServer         String?
  CreatedAt         DateTime     @default(now())
  UpdatedAt         DateTime     @updatedAt
  DeletedAt         DateTime?
  recordStatus      RecordStatus

  location       OccGate[]
  locationConter CounterGate[]
}

model OccTransaction {
  Id             Int       @id @default(autoincrement()) @db.Integer
  PlateNumberIn  String
  PlateNumberOut String?
  PathIn         String
  PathOut        String?
  Location       String?
  GateName       String?
  InTime         DateTime?
  OutTime        DateTime?
  CreatedAt      DateTime  @default(now())
  UpdatedAt      DateTime  @updatedAt
}

model OccGate {
  id           Int       @id @default(autoincrement()) @db.Integer
  id_location  Int
  gate         String
  channel_cctv String
  arduino      Int       @default(0)
  statusGate   Int       @default(0)
  id_tele      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  location OccRefLocation @relation(fields: [id_location], references: [id])
}

model OccIntercome {
  Id            Int      @id @default(autoincrement()) @db.Integer
  GateName      String
  Locations     String
  CountInCall   Int?
  CountMissCall Int?
  CreatedAt     DateTime @default(now())
}

model RefIssuer {
  id                      Int       @id @default(autoincrement()) @db.Integer
  issuerId                String?
  issuerName              String?
  IssuerLongName          String?
  Color                   String?
  LogoUrl                 String?
  SettlementPath          String?
  SettlementExtensionFile String?
  FlagRecon               String?
  CreatedOn               DateTime  @default(now())
  CreatedBy               String?
  UpdatedOn               DateTime  @updatedAt
  UpdatedBy               DateTime?
  DeletedOn               String?
  DeletedBy               String?
  RecordStatus            Int       @default(1)
}

model OccListMemberStyles {
  Id          Int      @id @default(autoincrement()) @db.Integer
  Name        String
  Email       String?
  PlateNumber String?
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt
}

model CounterGate {
  Id            Int      @id @default(autoincrement()) @db.Integer
  Date          String?
  LocationCode  String
  LocationName  String?
  CodeGate      String?
  CountInMotor  Int?     @default(0)
  CountOutMotor Int?     @default(0)
  CountInMobil  Int?     @default(0)
  CountOutMobil Int?     @default(0)
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  locationConter OccRefLocation @relation(fields: [LocationCode], references: [Code])
}

model userEventNobu {
  id        Int      @id @default(autoincrement()) @db.Integer
  nik       String   @unique
  event     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
