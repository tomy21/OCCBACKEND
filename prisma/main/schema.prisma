generator client {
  provider = "prisma-client-js"
  output   = "../generated/client-main"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MAIN")
}

model OccCategory {
  id          Int              @id @default(autoincrement())
  category    String
  createdBy   String
  modifyBy    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  occCategory OccDescription[]
}

model OccDescription {
  id          Int         @id @default(autoincrement())
  id_category Int
  object      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  createdBy   String
  modifyBy    String?
  category    OccCategory @relation(fields: [id_category], references: [id])
}

model OccIssue {
  id                    Int         @id @default(autoincrement())
  ticket                String
  category              String?
  lokasi                String?
  description           String?
  gate                  String?
  action                String?
  foto_in               String?
  foto_out              String?
  number_plate          String?
  TrxNo                 String?
  solusi                String?
  duration              String?
  status                statusIssue @default(new)
  createdBy             String
  modifiedBy            String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?
  foto_bukti_pembayaran String?
  foto_face_in          String?
  foto_face_out         String?

  @@map("OccIssue")
}

model OccRefLocation {
  id                Int           @id @default(autoincrement())
  Code              String        @unique
  Name              String
  Region            String?
  TID               String?
  Vendor            String?
  VendorParkingCode String?
  ShortName         String?
  Address           String?
  StartTime         DateTime?
  EndTime           DateTime?
  DateNext          Int?
  TimeZone          String?
  UrlServer         String?
  CreatedAt         DateTime      @default(now())
  UpdatedAt         DateTime      @updatedAt
  DeletedAt         DateTime?
  recordStatus      RecordStatus?
  locationConter    CounterGate[]
  location          OccGate[]
}

model OccTransaction {
  Id             Int       @id @default(autoincrement())
  PlateNumberIn  String
  PlateNumberOut String?
  PathIn         String
  PathOut        String?
  Location       String?
  GateName       String?
  InTime         DateTime?
  OutTime        DateTime?
  CreatedAt      DateTime  @default(now())
  UpdatedAt      DateTime  @updatedAt
}

model OccGate {
  id                 Int            @id @default(autoincrement())
  id_location        Int
  gate               String
  ip_lpr             String?
  arduino            Int?           @default(0)
  statusGate         Int?           @default(0)
  id_tele            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  user_lpr           String?
  password_lpr       String?
  ip_intercome       String?
  user_intercome     String?
  password_intercome String?
  location           OccRefLocation @relation(fields: [id_location], references: [id])
}

model OccIntercome {
  Id            Int      @id @default(autoincrement())
  GateName      String
  Locations     String
  CountInCall   Int?
  CountMissCall Int?
  CreatedAt     DateTime @default(now())
}

model RefIssuer {
  id                      Int       @id @default(autoincrement())
  issuerId                String?
  issuerName              String?
  IssuerLongName          String?
  Color                   String?
  LogoUrl                 String?
  SettlementPath          String?
  SettlementExtensionFile String?
  FlagRecon               String?
  CreatedOn               DateTime  @default(now())
  CreatedBy               String?
  UpdatedOn               DateTime  @updatedAt
  UpdatedBy               DateTime?
  DeletedOn               String?
  DeletedBy               String?
  RecordStatus            Int       @default(1)
}

model OccListMemberStyles {
  Id          Int      @id @default(autoincrement())
  Name        String
  Email       String?
  PlateNumber String?
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt
}

model CounterGate {
  Id             Int            @id @default(autoincrement())
  Date           String?
  LocationCode   String
  LocationName   String?
  CodeGate       String?
  CountInMotor   Int?           @default(0)
  CountOutMotor  Int?           @default(0)
  CountInMobil   Int?           @default(0)
  CountOutMobil  Int?           @default(0)
  CreatedAt      DateTime       @default(now())
  UpdatedAt      DateTime       @updatedAt
  locationConter OccRefLocation @relation(fields: [LocationCode], references: [Code])
}

model OccLogActivity {
  Id           Int      @id @default(autoincrement())
  NameActivity String?
  User         String?
  Action       String?
  Response     String?
  CreatedAt    DateTime @default(now())
}

model userEventNobu {
  id        Int      @id @default(autoincrement())
  nik       String   @unique
  event     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Users {
  id         Int       @id @default(autoincrement())
  name       String?   @db.VarChar(255)
  email      String?   @unique @db.VarChar(255)
  username   String?   @unique @db.VarChar(255)
  password   String?   @db.VarChar(255)
  role       Int?
  status     Int?
  inCall     Int?
  lastActive DateTime? @db.Timestamp(6)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @updatedAt @db.Timestamp(6)
  deletedAt  DateTime? @db.Timestamp(6)
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  menuId    Int
  action    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menus {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  name      String
  icon      String?
  link      String
  position  Int?
  status    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum statusIssue {
  new
  progress
  solved
}

enum RecordStatus {
  INACTIVE @map("0")
  ACTIVE   @map("1")
  DELETE   @map("2")
}
